# deploy/caddy.block —— **追加**到 /root/obsidian-livesync/Caddyfile 的站点块
#
# 实测（2026-09-17）：Caddy 跑在 Docker 容器 caddy-for-ols（compose 服务名 caddy），
# 既有两块 obsidian.*（纯 reverse_proxy，无 tls）与 reader.*（有 tls dns cloudflare）。
# → **照 reader.* 写，不要照 obsidian.***。
#
# 操作纪律（§12.2）：改前备份 + 记 sha256 → caddy validate 绿 → caddy reload → 失败即回滚；
# **禁止** docker compose up -d（会连带重建 CouchDB / dsh-web）。

math.zhu2006.xyz {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# 浏览器走登录页；带 Authorization 头的**服务间请求（DSH 插件）绕过它**（ADR-021）
	@browser {
		not header Authorization *
	}
	forward_auth @browser 127.0.0.1:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
	reverse_proxy 127.0.0.1:8081
}

# Authelia 自己的登录页（证书同样用 Cloudflare DNS 挑战）
auth.zhu2006.xyz {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy 127.0.0.1:9091
}

# 数学 DSH 的公网入口（2026-10-09 加）：回环 39195 + Authelia 登录，与 math.zhu2006.xyz 同款
# ⚠️ 配了这一段，dsh-math.service 的 ExecStart 也必须带 `--trusted-host math-dsh.zhu2006.xyz`（否则 401）
math-dsh.zhu2006.xyz {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# 浏览器走登录页；带 Authorization 头的服务间请求绕过（ADR-021 同款）
	@browser {
		not header Authorization *
	}
	forward_auth @browser 127.0.0.1:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
	reverse_proxy 127.0.0.1:39195
}
