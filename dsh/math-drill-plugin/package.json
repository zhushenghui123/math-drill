{
  "name": "@math-drill/dsh-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "考研数学 × DeepSeek Harness 桥接插件：宿主半边（只读数据通路 + 两个 agent 工具 + 只读状态路由）+ 客户端半边（对话输入区状态条）",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^0.1.1-rc.1"
  },
  "scripts": {
    "test": "node --test tests/",
    "link-dsh-deps": "node tools/link-dsh-deps.mjs",
    "build": "node tools/build-client.mjs"
  },
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ]
}
